# Set these environment variables before `npm run build`, or add them in Vercel Project Settings.
# The build writes the values to dist/config.js; only public URL and anon key belong in the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend, config.js, or this repository.
